## 🎯 Integration Examples

### Example 1: Add to Home Screen (Corner Widget)

```javascript
// screens/HomeScreen.js
import React from 'react';
import { View, Text, StyleSheet } from 'react-native';
import CharacterCorner from '../components/Character/CharacterCorner';
import { useCharacter } from '../hooks/useCharacter';

const HomeScreen = ({ navigation }) => {
  const { character, state } = useCharacter();

  const handleCharacterPress = () => {
    navigation.navigate('Chat'); // Navigate to chat screen
  };

  return (
    <View style={styles.container}>
      <Text style={styles.title}>Home Screen</Text>
      
      {/* Your existing home screen content */}
      
      {/* Add character in bottom-left corner */}
      {character && (
        <CharacterCorner
          characterUrl={character.modelUrl}
          isSpeaking={state.isSpeaking}
          isListening={state.isListening}
          emotion={state.emotion}
          onPress={handleCharacterPress}
          statusText={state.isSpeaking ? 'Speaking...' : ''}
        />
      )}
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#0F0F1E',
  },
  title: {
    fontSize: 24,
    color: '#FFF',
    padding: 20,
  },
});

export default HomeScreen;
```

