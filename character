## ⚙️ Using the Character Hook

### Basic Usage

```javascript
import { useCharacter } from '../hooks/useCharacter';

function MyComponent() {
  const { 
    character,      // Current character object
    state,          // { isListening, isSpeaking, emotion }
    speak,          // Speak text with TTS
    sendMessage,    // Send message to API
    updateCharacter // Update character data
  } = useCharacter();

  // Make character speak
  const sayHello = () => {
    speak("Hello there!", "happy");
  };

  // Send message to API
  const chatWithCharacter = async () => {
    try {
      const response = await sendMessage("How are you?");
      console.log("Character replied:", response);
    } catch (error) {
      console.error("Error:", error);
    }
  };

  return (
    <View>
      {/* Your component */}
    </View>
  );
}
```

