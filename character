## 🌐 API Integration

### Setup API Client

```javascript
// services/apiClient.js
import axios from 'axios';

const API_BASE_URL = 'https://your-api.com';

export const sendChatMessage = async (message, characterContext) => {
  try {
    const response = await axios.post(
      `${API_BASE_URL}/friend`,
      {
        message,
        characterContext,
      },
      {
        timeout: 15000,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer YOUR_API_KEY', // Add your API key
        },
      }
    );

    return {
      reply: response.data.reply,
      emotion: response.data.emotion || 'neutral',
    };
  } catch (error) {
    console.error('API Error:', error);
    throw error;
  }
};
```

### Expected API Format

```javascript
// Request
{
  "message": "Hello!",
  "characterContext": {
    "name": "AI Companion",
    "gender": "female",
    "personality": "friendly"
  }
}

// Response
{
  "reply": "Hi there! How can I help you?",
  "emotion": "happy"
}
```

